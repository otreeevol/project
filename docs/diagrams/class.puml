@startuml
skinparam defaultFontName "Microsoft YaHei"
' 学生信息管理系统 —— 详细设计类图
hide empty members

class StudentController {
  +index()
  +add()
  +edit(student_id)
  +delete(student_id)
}

class StudentService {
  +list_students(conn, keyword)
  +get_student(conn, id)
  +add_student(conn, data)
  +update_student(conn, id, data)
  +delete_student(conn, id)
  -_validate(data)
}

class StudentDao {
  +list_all(conn, keyword)
  +get(conn, id)
  +get_by_no(conn, no)
  +create(conn, data)
  +update(conn, id, data)
  +delete(conn, id)
}

class GradeController {
  +index()
  +add()
  +edit(grade_id)
  +delete(grade_id)
  +statistics()
}

class GradeService {
  +add_grade(conn, data)
  +update_grade(conn, id, data)
  +statistics(conn, course_id)
  -_validate(data)
}

class GradeDao {
  +list_all(conn, ...)
  +create(conn, ...)
  +update(conn, ...)
  +delete(conn, ...)
  +statistics(conn, course_id)
}

class AuthService {
  +authenticate(conn, username, password)
  +create_user(conn, username, password, role)
}

class UserDao {
  +get_by_username(conn, username)
  +create(conn, username, hash, role)
}

class db {
  +connect(db_path)
  +get_db()
  +close_db()
}

StudentController --> StudentService
StudentService --> StudentDao
GradeController --> GradeService
GradeService --> GradeDao
AuthService --> UserDao
StudentDao ..> db
GradeDao ..> db
UserDao ..> db
@enduml

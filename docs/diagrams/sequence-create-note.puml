@startuml
' 小米便签 —— 顺序图：新建便签
actor "用户" as User
participant "NotesListActivity" as LA
participant "NoteEditActivity" as EA
participant "WorkingNote" as WN
participant "NotesProvider" as NP
database "SQLite\nnote.db" as DB

User -> LA : 点击"新建便签"
LA -> EA : 启动编辑界面
activate EA
User -> EA : 输入文字内容
User -> EA : 点击保存
EA -> WN : 创建 WorkingNote
EA -> WN : setWorkingText(text)
EA -> WN : saveNote()
activate WN
WN -> NP : insert(CONTENT_NOTE_URI, values)
activate NP
NP -> DB : INSERT INTO note / data
DB --> NP : 成功
NP --> WN : 返回 Uri
deactivate NP
WN --> EA : 保存成功
deactivate WN
EA -> LA : finish() 返回并刷新
deactivate EA
LA --> User : 显示新便签
@enduml

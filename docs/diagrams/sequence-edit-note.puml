@startuml
' 小米便签 —— 顺序图：编辑便签
actor "用户" as User
participant "NotesListActivity" as LA
participant "NoteEditActivity" as EA
participant "WorkingNote" as WN
participant "NotesProvider" as NP
database "SQLite\nnote.db" as DB

User -> LA : 点击某条便签
LA -> NP : query(按 _id)
activate NP
NP -> DB : SELECT ...
DB --> NP : Cursor
NP --> LA : 便签数据
deactivate NP
LA -> EA : 启动并传入便签 ID
activate EA
EA -> NP : 查询便签详情
NP -> DB : SELECT ...
DB --> NP : Cursor
NP --> EA : Note 数据
EA -> WN : 加载 Note
User -> EA : 修改内容
EA -> WN : setWorkingText(text)
User -> EA : 点击保存
EA -> WN : saveNote()
activate WN
WN -> NP : update(CONTENT_NOTE_URI, values)
activate NP
NP -> DB : UPDATE note / data
DB --> NP : 成功
NP --> WN : 返回行数
deactivate NP
WN --> EA : 保存成功
deactivate WN
EA -> LA : finish() 返回并刷新
deactivate EA
LA --> User : 显示更新后的便签
@enduml

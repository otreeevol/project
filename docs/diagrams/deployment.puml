@startuml
skinparam defaultFontName "Microsoft YaHei"
' 学生信息管理系统 —— 部署图
node "服务器" {
  node "Python 运行时" {
    component "Flask 应用\napp.py" as App
    artifact "学生信息管理系统" as Art
  }
  database "sms.db\n(SQLite)" as DB
  App --> DB
  Art --> App
}

node "客户端" {
  component "Web 浏览器" as Browser
}

Browser ..> App : HTTP
@enduml

@startuml
' 小米便签 —— 部署图
node "Android 设备" {
  node "应用进程 net.micode.notes" {
    artifact "小米便签 APK" as APK
    component "NotesListActivity" as UI
    component "NotesProvider" as CP
    component "NotesDatabaseHelper" as DBH
  }
  database "note.db\n(SQLite)" as DB
  component "AlarmManager\n闹钟服务" as Alarm
  component "AppWidget\n桌面小部件" as Widget
}

cloud "Google Tasks 服务器" as GT

UI --> CP
CP --> DBH
DBH --> DB
APK --> Alarm
APK --> Widget
CP ..> GT : HTTPS 同步
@enduml

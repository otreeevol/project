@startuml
skinparam defaultFontName "Microsoft YaHei"
' 学生信息管理系统 —— 构件图
skinparam componentStyle rectangle

package "表示层" {
  component "AuthController\n登录" as AuthC
  component "StudentController\n学生管理" as StudentC
  component "GradeController\n成绩管理" as GradeC
}

package "业务逻辑层" {
  component "AuthService\n认证服务" as AuthS
  component "StudentService\n学生服务" as StudentS
  component "GradeService\n成绩服务" as GradeS
}

package "数据访问层" {
  component "UserDao\n用户访问" as UserD
  component "StudentDao\n学生访问" as StudentD
  component "GradeDao\n成绩访问" as GradeD
}

database "sms.db\n(SQLite)" as DB

AuthC --> AuthS
StudentC --> StudentS
GradeC --> GradeS
AuthS --> UserD
StudentS --> StudentD
GradeS --> GradeD
UserD --> DB
StudentD --> DB
GradeD --> DB
@enduml

@startuml
' 学生信息管理系统 —— 顺序图：登录
actor "用户" as User
participant "AuthController" as C
participant "AuthService" as S
participant "UserDao" as D
database "SQLite\nsms.db" as DB

User -> C : 提交用户名/密码
C -> S : authenticate(username, password)
activate S
S -> D : get_by_username(username)
activate D
D -> DB : SELECT * FROM user
DB --> D : 用户记录
D --> S : 用户对象
deactivate D
S -> S : check_password_hash 校验密码
alt 校验成功
  S --> C : 返回用户
  C --> User : 写入 session 并进入首页
else 校验失败
  S --> C : 抛出 AuthError
  C --> User : 提示"用户名或密码错误"
end
deactivate S
@enduml

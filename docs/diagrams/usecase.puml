@startuml
skinparam defaultFontName "Microsoft YaHei"
' 学生信息管理系统 —— 用例图
left to right direction
skinparam packageStyle rectangle

actor "管理员/教师" as User

rectangle "学生信息管理系统" {
  usecase "登录系统" as UC1
  usecase "管理学生信息" as UC2
  usecase "管理班级" as UC3
  usecase "管理课程" as UC4
  usecase "管理成绩" as UC5
  usecase "成绩统计" as UC6
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
UC5 ..> UC1 : <<include>>
UC6 ..> UC1 : <<include>>
@enduml

@startuml
skinparam defaultFontName "Microsoft YaHei"
' 学生信息管理系统 —— 活动图：新增学生
start
:打开新增学生表单;
:填写学号、姓名等信息;
:点击保存;

if (学号、姓名是否为空?) then (为空)
  :提示"学号/姓名不能为空";
  :返回表单;
  stop
else (非空)
endif

if (学号是否已存在?) then (已存在)
  :提示"学号已存在";
  :返回表单;
  stop
else (不存在)
  :StudentDao 写入数据库;
  :重定向到列表并提示"学生添加成功";
  stop
endif
@enduml
